    ]
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.0",
    "brace-expansion@^5.0.0": "^5.0.12",
    "fast-uri": "^3.1.8",
    "source-map-js": "^1.2.2"
